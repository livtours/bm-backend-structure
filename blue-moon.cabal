name:           blue-moon
version:        0.0.0
build-type:     Simple

flag dev
  description: Turn on development settings, like auto-reload templates.
  manual: False
  default: False

flag force-static-files-recomp
  description: Recompile Settings.StaticFiles module
  manual: False
  default: False

flag ide-info
  description: Write ide-info into .hie dir
  manual: False
  default: True

flag library-only
  description: Build for use with "yesod devel"
  manual: False
  default: False

library
  exposed-modules:
      Application
      Common
  other-modules:
      Paths_blue_moon
  hs-source-dirs:
      src
  default-extensions:
      ApplicativeDo
      DataKinds
      DeepSubsumption
      DeriveAnyClass
      DerivingStrategies
      DerivingVia
      DuplicateRecordFields
      GADTs
      LambdaCase
      MultiWayIf
      NoImplicitPrelude
      OverloadedLabels
      OverloadedRecordDot
      OverloadedStrings
      QuasiQuotes
      RecordWildCards
      StrictData
      UndecidableInstances
      TemplateHaskell
      ViewPatterns
  build-depends:
      base >=4.9.1.0 && <5
    , blue-models
    , blue-prelude
  default-language: GHC2021
  if flag(ide-info)
    ghc-options: -fwrite-ide-info -hiedir=.hie -Werror -Wall -fwarn-tabs -Wunused-packages
  else
    ghc-options: -Werror -Wall -fwarn-tabs -Wunused-packages
  if (flag(dev)) || (flag(library-only))
    ghc-options: -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints -O0 -fobject-code
    cpp-options: -DDEVELOPMENT
  else
    ghc-options: -O
  if flag(force-static-files-recomp)
    cpp-options: -DFORCE_STATIC_FILES_RECOMP

executable blue-moon
  main-is: main.hs
